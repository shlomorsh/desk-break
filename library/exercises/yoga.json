{ "category": {"id": "yoga", "he": "יוגה", "en": "Yoga"},
  "exercises": [
    {"id": "mountain-pose-breath", "he": "הר עם נשימה", "en": "Mountain pose with breath", "amount": "6 נשימות", "steps": ["עומדים ישר, כפות רגליים ברוחב האגן.", "בשאיפה מרימים ידיים דרך הצדדים למעלה.", "בנשיפה מורידים לאט חזרה."], "amount_en": "6 breaths", "steps_en": ["Stand tall with your feet hip-width apart.", "Breathe in and raise your arms out to the sides and up.", "Breathe out and slowly lower them back down."], "beat": 1.5, "keys": [{}, {"arm": [0, 0, 88]}, {"arm": [-170, 0, 8], "hold": 1}, {"arm": [0, 0, 88]}]},
    {"id": "upward-salute-gentle", "he": "ידיים לשמיים", "en": "Gentle upward salute", "amount": "5 פעמים", "steps": ["עומדים בתנוחת הר.", "מרימים ידיים למעלה ומאריכים את הגב.", "מבט מעט למעלה, בלי להתכופף אחורה בכוח.", "!אם הגב התחתון לוחץ – נשארים ישרים."], "amount_en": "5 times", "steps_en": ["Stand in mountain pose.", "Raise your arms up and lengthen your back.", "Look up a little, without forcing a backbend.", "!If your lower back feels pressure, stay upright."], "beat": 1.4, "keys": [{}, {"arm": [-170, 0, 8], "spine": [-8, 0, 0], "neck": [-15, 0, 0], "hold": 1.5}]},
    {"id": "standing-crescent-side-bend", "he": "סהר בעמידה", "en": "Standing crescent side bend", "amount": "4 לכל צד", "steps": ["ידיים למעלה, כפות צמודות.", "נוטים לאט לצד אחד, כמו סהר.", "חוזרים למרכז ונוטים לצד השני."], "amount_en": "4 each side", "steps_en": ["Raise your arms up and press your palms together.", "Slowly lean to one side, like a crescent moon.", "Come back to center and lean to the other side."], "beat": 1.4, "keys": [{"arm": [-172, 0, 2]}, {"arm": [-172, 0, 2], "spine": [0, 0, 24], "hold": 1.5}, {"arm": [-172, 0, 2]}, {"arm": [-172, 0, 2], "spine": [0, 0, -24], "hold": 1.5}]},
    {"id": "chair-pose-gentle", "he": "כיסא קל", "en": "Gentle chair pose", "amount": "5 נשימות", "steps": ["רגליים צמודות, מתכופפים בברכיים כאילו מתיישבים.", "הישבן אחורה, הברכיים לא עוברות את האצבעות.", "ידיים למעלה ונושמים.", "!כפיפה קטנה בלבד אם הברכיים רגישות."], "amount_en": "5 breaths", "steps_en": ["Bring your feet together and bend your knees as if sitting down.", "Push your hips back and keep your knees behind your toes.", "Raise your arms and breathe.", "!Bend only a little if your knees are sensitive."], "beat": 1.5, "keys": [{"hips": [0, -70, 0]}, {"hips": [0, -70, 0], "leg": [-35, 0, 4], "knee": [55, 0, 0], "foot": [-20, 0, 0], "spine": [18, 0, 0], "pos": [0.05, 0, -0.02], "arm": [-150, 0, 8], "hold": 3}]},
    {"id": "chair-pose-prayer-twist", "he": "כיסא עם פיתול", "en": "Chair pose prayer twist", "amount": "3 לכל צד", "steps": ["יורדים לכיסא קל, ידיים צמודות מול החזה.", "מסובבים את החזה לצד אחד.", "חוזרים למרכז ומסובבים לצד השני.", "!הברכיים נשארות ישרות קדימה, הפיתול רק מהחזה."], "amount_en": "3 each side", "steps_en": ["Sink into a gentle chair pose with your palms together in front of your chest.", "Turn your chest to one side.", "Come back to center and turn to the other side.", "!Keep your knees pointing straight ahead. Twist only from the chest."], "beat": 1.4, "keys": [{"hips": [0, -70, 0], "leg": [-35, 0, 4], "knee": [55, 0, 0], "foot": [-20, 0, 0], "spine": [18, 0, 0], "pos": [0.05, 0, -0.02], "arm": [-35, 0, -25], "elbow": [-120, 0, 0]}, {"hips": [0, -70, 0], "leg": [-35, 0, 4], "knee": [55, 0, 0], "foot": [-20, 0, 0], "spine": [18, 35, 0], "pos": [0.05, 0, -0.02], "arm": [-35, 0, -25], "elbow": [-120, 0, 0], "hold": 1.5}, {"hips": [0, -70, 0], "leg": [-35, 0, 4], "knee": [55, 0, 0], "foot": [-20, 0, 0], "spine": [18, 0, 0], "pos": [0.05, 0, -0.02], "arm": [-35, 0, -25], "elbow": [-120, 0, 0]}, {"hips": [0, -70, 0], "leg": [-35, 0, 4], "knee": [55, 0, 0], "foot": [-20, 0, 0], "spine": [18, -35, 0], "pos": [0.05, 0, -0.02], "arm": [-35, 0, -25], "elbow": [-120, 0, 0], "hold": 1.5}]},
    {"id": "warrior-1-gentle", "he": "לוחם 1", "en": "Warrior 1", "amount": "5 נשימות לכל צד", "steps": ["צעד גדול קדימה, הרגל האחורית ישרה.", "כופפים את הברך הקדמית מעל הקרסול.", "ידיים למעלה, מבט קדימה.", "!אם הברך כואבת – צעד קצר יותר וכפיפה קטנה."], "amount_en": "5 breaths each side", "steps_en": ["Take a big step forward and keep your back leg straight.", "Bend your front knee over your ankle.", "Raise your arms and look ahead.", "!If your knee hurts, take a shorter step and bend less."], "beat": 1.4, "keys": [{"hips": [0, -70, 0]}, {"hips": [0, -70, 0], "legL": [-45, 0, 0], "kneeL": [50, 0, 0], "footL": [-5, 0, 0], "legR": [22, 0, 0], "kneeR": [8, 0, 0], "footR": [15, 0, 0], "arm": [-170, 0, 8], "hold": 3}, {"hips": [0, -70, 0]}, {"hips": [0, -70, 0], "legR": [-45, 0, 0], "kneeR": [50, 0, 0], "footR": [-5, 0, 0], "legL": [22, 0, 0], "kneeL": [8, 0, 0], "footL": [15, 0, 0], "arm": [-170, 0, 8], "hold": 3}]},
    {"id": "warrior-2", "he": "לוחם 2", "en": "Warrior 2", "amount": "5 נשימות לכל צד", "steps": ["רגליים רחבות, כף רגל קדמית פונה הצידה.", "כופפים את הברך הקדמית מעל הקרסול.", "ידיים פרושות לצדדים, מבט מעל היד הקדמית.", "!הברך מעל הקרסול, לא נופלת פנימה."], "amount_en": "5 breaths each side", "steps_en": ["Stand with your feet wide and turn your front foot out to the side.", "Bend your front knee over your ankle.", "Stretch your arms out to the sides and look out over your front hand.", "!Keep your knee over your ankle, not dropping inward."], "beat": 1.4, "keys": [{"leg": [0, 90, 30], "foot": [0, -75, 0], "arm": [0, 0, 88]}, {"legL": [0, 90, 45], "kneeL": [60, 0, 0], "legR": [0, 90, 28], "footR": [0, -75, 0], "arm": [0, 0, 88], "neck": [0, 60, 0], "hold": 3}, {"leg": [0, 90, 30], "foot": [0, -75, 0], "arm": [0, 0, 88]}, {"legR": [0, 90, 45], "kneeR": [60, 0, 0], "legL": [0, 90, 28], "footL": [0, -75, 0], "arm": [0, 0, 88], "neck": [0, -60, 0], "hold": 3}]},
    {"id": "reverse-warrior-gentle", "he": "לוחם הפוך", "en": "Reverse warrior", "amount": "3 לכל צד", "steps": ["מתחילים בלוחם 2.", "היד הקדמית עולה למעלה ואחורה בקשת.", "היד האחורית מחליקה על הרגל האחורית.", "נושמים וחוזרים ללוחם 2."], "amount_en": "3 each side", "steps_en": ["Start in warrior 2.", "Sweep your front arm up and back in an arc.", "Slide your back hand down your back leg.", "Breathe, then return to warrior 2."], "beat": 1.4, "keys": [{"legL": [0, 90, 45], "kneeL": [60, 0, 0], "legR": [0, 90, 28], "footR": [0, -75, 0], "arm": [0, 0, 88], "neck": [0, 60, 0]}, {"legL": [0, 90, 45], "kneeL": [60, 0, 0], "legR": [0, 90, 28], "footR": [0, -75, 0], "spine": [0, 0, 20], "armL": [0, 0, 160], "armR": [0, 0, 15], "neck": [0, 20, 0], "hold": 2}, {"legR": [0, 90, 45], "kneeR": [60, 0, 0], "legL": [0, 90, 28], "footL": [0, -75, 0], "arm": [0, 0, 88], "neck": [0, -60, 0]}, {"legR": [0, 90, 45], "kneeR": [60, 0, 0], "legL": [0, 90, 28], "footL": [0, -75, 0], "spine": [0, 0, -20], "armR": [0, 0, 160], "armL": [0, 0, 15], "neck": [0, -20, 0], "hold": 2}]},
    {"id": "extended-side-angle-gentle", "he": "זווית צד קלה", "en": "Gentle extended side angle", "amount": "3 נשימות לכל צד", "steps": ["מלוחם 2 מניחים אמה על הירך הקדמית.", "היד השנייה נמתחת באלכסון מעל האוזן.", "קו אחד ארוך מהרגל האחורית עד האצבעות."], "amount_en": "3 breaths each side", "steps_en": ["From warrior 2, rest your forearm on your front thigh.", "Reach your other arm on a diagonal over your ear.", "Make one long line from your back foot to your fingertips."], "beat": 1.4, "keys": [{"legL": [0, 90, 45], "kneeL": [60, 0, 0], "legR": [0, 90, 28], "footR": [0, -75, 0], "arm": [0, 0, 88]}, {"legL": [0, 90, 45], "kneeL": [75, 0, 0], "legR": [0, 90, 28], "footR": [0, -75, 0], "spine": [0, 0, -55], "armL": [0, 0, 35], "elbowL": [-60, 0, 0], "armR": [0, 0, 172], "hold": 2.5}, {"legR": [0, 90, 45], "kneeR": [60, 0, 0], "legL": [0, 90, 28], "footL": [0, -75, 0], "arm": [0, 0, 88]}, {"legR": [0, 90, 45], "kneeR": [75, 0, 0], "legL": [0, 90, 28], "footL": [0, -75, 0], "spine": [0, 0, 55], "armR": [0, 0, 35], "elbowR": [-60, 0, 0], "armL": [0, 0, 172], "hold": 2.5}]},
    {"id": "triangle-pose", "he": "משולש", "en": "Triangle pose", "amount": "3 נשימות לכל צד", "steps": ["רגליים רחבות וישרות, כף רגל קדמית פונה הצידה.", "נוטים מעל הרגל הקדמית, יד למטה על השוק.", "היד השנייה למעלה לשמיים.", "!היד על השוק, לא על הברך. לא צריך להגיע לרצפה."], "amount_en": "3 breaths each side", "steps_en": ["Stand with your legs wide and straight, front foot turned out to the side.", "Lean over your front leg and rest your hand on your shin.", "Reach your other arm up to the sky.", "!Keep your hand on your shin, not your knee. You don't need to reach the floor."], "beat": 1.5, "keys": [{"leg": [0, 90, 30], "foot": [0, -75, 0], "arm": [0, 0, 88]}, {"legL": [0, 90, 30], "legR": [0, 90, 28], "footR": [0, -75, 0], "spine": [0, 0, -65], "armL": [0, 0, 62], "armR": [0, 0, 115], "hold": 2.5, "elbowL": [0, 0, 0], "elbowR": [0, 0, 0]}, {"leg": [0, 90, 30], "foot": [0, -75, 0], "arm": [0, 0, 88]}, {"legR": [0, 90, 30], "legL": [0, 90, 28], "footL": [0, -75, 0], "spine": [0, 0, 65], "armR": [0, 0, 62], "armL": [0, 0, 115], "hold": 2.5, "elbowR": [0, 0, 0], "elbowL": [0, 0, 0]}]},
    {"id": "warrior-3-gentle", "he": "לוחם 3 קל", "en": "Gentle warrior 3", "amount": "3 לכל רגל", "steps": ["עומדים על רגל אחת, ברך רכה.", "גוף נוטה קדימה והרגל השנייה עולה אחורה.", "ידיים קדימה, קו אחד מהידיים לעקב.", "!אפשר להחזיק בקיר או בכיסא לשיווי משקל."], "amount_en": "3 each leg", "steps_en": ["Stand on one leg with a soft knee.", "Tip your body forward and lift your other leg behind you.", "Reach your arms forward, making one line from your hands to your heel.", "!You can hold a wall or a chair for balance."], "beat": 1.5, "keys": [{"hips": [0, -70, 0]}, {"hips": [0, -70, 0], "spine": [60, 0, 0], "legR": [55, 0, 0], "kneeL": [8, 0, 0], "arm": [-170, 0, 8], "neck": [-10, 0, 0], "hold": 2}, {"hips": [0, -70, 0]}, {"hips": [0, -70, 0], "spine": [60, 0, 0], "legL": [55, 0, 0], "kneeR": [8, 0, 0], "arm": [-170, 0, 8], "neck": [-10, 0, 0], "hold": 2}]},
    {"id": "pyramid-pose-soft", "he": "פירמידה רכה", "en": "Soft pyramid pose", "amount": "3 נשימות לכל צד", "steps": ["רגל אחת קדימה, רגל אחת אחורה, צעד בינוני.", "מתכופפים מעל הרגל הקדמית עם גב ארוך.", "ידיים יורדות לשוק, ברכיים רכות.", "!לא נועלים את הברך הקדמית."], "amount_en": "3 breaths each side", "steps_en": ["Step one leg forward and one leg back, a medium step apart.", "Fold over your front leg with a long back.", "Bring your hands down to your shin and keep your knees soft.", "!Don't lock your front knee."], "beat": 1.5, "keys": [{"hips": [0, -70, 0]}, {"hips": [0, -70, 0], "legL": [-25, 0, 0], "kneeL": [8, 0, 0], "footL": [17, 0, 0], "legR": [20, 0, 0], "footR": [10, 0, 0], "spine": [65, 0, 0], "neck": [10, 0, 0], "arm": [-65, 0, 0], "elbow": [0, 0, 0], "hold": 2.5}, {"hips": [0, -70, 0]}, {"hips": [0, -70, 0], "legR": [-25, 0, 0], "kneeR": [8, 0, 0], "footR": [17, 0, 0], "legL": [20, 0, 0], "footL": [10, 0, 0], "spine": [65, 0, 0], "neck": [10, 0, 0], "arm": [-65, 0, 0], "elbow": [0, 0, 0], "hold": 2.5}]},
    {"id": "goddess-pose-gentle", "he": "אלה", "en": "Gentle goddess pose", "amount": "5 פעמים", "steps": ["רגליים רחבות, אצבעות פונות מעט החוצה.", "כופפים ברכיים קצת, ידיים בצורת W.", "עולים ויורדים לאט.", "!הברכיים בכיוון האצבעות, כפיפה קטנה."], "amount_en": "5 times", "steps_en": ["Stand with your feet wide and toes turned out a little.", "Bend your knees slightly and hold your arms in a W shape.", "Slowly rise up and sink down.", "!Keep your knees in line with your toes and bend only a little."], "beat": 1.3, "keys": [{"leg": [0, 90, 22], "foot": [0, -45, 0], "arm": [0, 90, 88], "elbow": [-90, 0, 0]}, {"leg": [0, 90, 40], "knee": [42, 0, 0], "foot": [0, -45, 0], "arm": [0, 90, 88], "elbow": [-90, 0, 0], "hold": 1}]},
    {"id": "tree-pose-hands-heart", "he": "עץ עם ידיים בלב", "en": "Tree pose, hands at heart", "amount": "20 שניות לכל רגל", "steps": ["עומדים על רגל אחת.", "כף הרגל השנייה על השוק, לא על הברך.", "ידיים צמודות מול החזה, מבט לנקודה קבועה."], "amount_en": "20 seconds each leg", "steps_en": ["Stand on one leg.", "Place your other foot on your shin, not on your knee.", "Press your palms together in front of your chest and look at one fixed spot."], "beat": 1.2, "keys": [{}, {"arm": [-35, 0, -25], "elbow": [-120, 0, 0], "legL": [0, 90, 30], "kneeL": [100, 0, 0], "hold": 3}, {}, {"arm": [-35, 0, -25], "elbow": [-120, 0, 0], "legR": [0, 90, 30], "kneeR": [100, 0, 0], "hold": 3}]},
    {"id": "yoga-tree-kickstand", "he": "עץ עם עקב על הרצפה", "en": "Kickstand tree pose", "amount": "20 שניות לכל רגל", "steps": ["עקב אחד צמוד לקרסול השני, האצבעות על הרצפה.", "הברך פונה החוצה.", "ידיים עולות למעלה כמו ענפים."], "amount_en": "20 seconds each leg", "steps_en": ["Rest one heel against your other ankle, with your toes on the floor.", "Turn your knee out to the side.", "Raise your arms up like branches."], "beat": 1.2, "keys": [{}, {"legL": [0, 90, 15], "kneeL": [40, 0, 0], "footL": [30, 0, 0], "arm": [-165, 0, 20], "hold": 3}, {}, {"legR": [0, 90, 15], "kneeR": [40, 0, 0], "footR": [30, 0, 0], "arm": [-165, 0, 20], "hold": 3}]},
    {"id": "standing-forward-fold-soft", "he": "כפיפה קדימה בעמידה", "en": "Soft standing forward fold", "amount": "5 נשימות", "steps": ["ברכיים כפופות קלות.", "מתכופפים מהירכיים, ראש וידיים תלויים.", "עולים לאט, חוליה אחר חוליה.", "!ברכיים כפופות שומרות על הגב התחתון."], "amount_en": "5 breaths", "steps_en": ["Bend your knees slightly.", "Fold forward from your hips and let your head and arms hang.", "Roll up slowly, one vertebra at a time.", "!Bent knees protect your lower back."], "beat": 1.6, "keys": [{"hips": [0, -70, 0]}, {"hips": [0, -70, 0], "leg": [-10, 0, 0], "knee": [20, 0, 0], "foot": [-10, 0, 0], "spine": [80, 0, 0], "neck": [10, 0, 0], "arm": [-80, 0, 0], "elbow": [0, 0, 0], "hold": 3}]},
