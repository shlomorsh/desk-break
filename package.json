{
  "name": "desk-break",
  "version": "0.2.2",
  "description": "A wooden mannequin on your desktop that shows you a short exercise while the computer works.",
  "license": "MIT",
  "author": "Shlomy Reshef",
  "homepage": "https://parametric.co.il/desk-break/",
  "repository": "github:shlomorsh/desk-break",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "il.co.parametric.deskbreak",
    "productName": "Desk Break",
    "executableName": "DeskBreak",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "library/exercises.glb",
      "library/exercises.json",
      "library/player.js",
      "library/wood.png",
      "package.json",
      "vendor/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon.png",
      "artifactName": "DeskBreak-Setup.exe",
      "legalTrademarks": "Desk Break"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Desk Break",
      "runAfterFinish": true,
      "uninstallDisplayName": "Desk Break"
    },
    "directories": {
      "output": "dist"
    },
    "copyright": "Copyright (c) 2026 Shlomy Reshef"
  }
}
